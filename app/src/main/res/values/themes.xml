<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.MyApplication" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/nur_splash_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Sistem açılış ekranı: tüm Android sürümlerinde aynı, ardından uygulama içi animasyon devralır -->
    <style name="Theme.NurVakti.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/nur_splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.MyApplication</item>
    </style>
</resources>
